<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thanh tìm kiếm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Tìm địa điểm hoặc nhập: 21.0285, 105.8542"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_primary"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="Tìm"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bảng điều khiển dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/card_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chạm vào bản đồ để chọn vị trí"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="@color/muted"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/jitter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dao động nhẹ (giống GPS thật)"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_primary"
            android:text="▶  Bắt đầu giả lập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_soft"
                android:text="☆ Lưu"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/btnFavs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_soft"
                android:text="★ Đã lưu"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_soft"
                android:text="\\? Hướng dẫn"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
